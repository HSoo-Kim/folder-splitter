<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9.5pt</ApplicationDefaultFont>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyName>FolderSplitter</AssemblyName>
    <RootNamespace>QuadExplorer</RootNamespace>
    <Version>0.4.0</Version>
    <Product>Folder Splitter</Product>
    <Description>A native Windows file manager with independent tabbed panes.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/app.ico" LogicalName="QuadExplorer.AppIcon" />
    <InternalsVisibleTo Include="QuadExplorer.UiTests" />
  </ItemGroup>
</Project>
